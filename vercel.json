{
  "buildCommand": "bash build.sh",
  "outputDirectory": "site",
  "installCommand": "",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "(www\\.)?crownplasticandpaper\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.css@(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)\\.js@(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/wp-content/(.*)\\.(png|jpe?g|webp|gif|svg|avif|woff2?|ttf|otf|ico|mp4)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/upgrade/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/wp-content/(.*)\\.(css|js)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|favicon\\.ico|icon-192\\.png|apple-touch-icon\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/cost-effective-dinner-napkin-solutions-for-restaurants-and-catering-businesses-:n(2|3)/",
      "destination": "/cost-effective-dinner-napkin-solutions-for-restaurants-and-catering-businesses/",
      "permanent": true
    },
    {
      "source": "/how-wholesale-food-packaging-helps-restaurants-reduce-operating-costs-2/",
      "destination": "/how-wholesale-food-packaging-helps-restaurants-reduce-operating-costs/",
      "permanent": true
    },
    {
      "source": "/product/single-fold-napkins/",
      "destination": "/product/single-multi-and-c-fold-napkins/",
      "permanent": true
    },
    {
      "source": "/product/single-fold-napkins/single-fold-napkins/",
      "destination": "/product/single-multi-and-c-fold-napkins/",
      "permanent": true
    },
    {
      "source": "/products/product_cat-:cats(.*-or-.*)/",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/:year(\\d{4})/:rest*",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/comments/feed/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/:map(.*sitemap.*\\.html)",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/contact-us.html",
      "destination": "/contact-us/",
      "permanent": true
    },
    {
      "source": "/applications.html",
      "destination": "/applications/",
      "permanent": true
    },
    {
      "source": "/business-partnership.html",
      "destination": "/business-partnership/",
      "permanent": true
    },
    {
      "source": "/index.html@p=:id(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    }
  ]
}
