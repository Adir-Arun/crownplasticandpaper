{
  "buildCommand": "bash build.sh",
  "outputDirectory": "site",
  "installCommand": "",
  "framework": null,
  "headers": [
    {
      "source": "/wp-content/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/upgrade/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
